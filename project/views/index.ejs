<%- include("partials/head", { title: title }) %>

<body class="astana-page">

    <%- include("partials/header") %>

    <!-- 3D СЦЕНА (после шапки сайта) -->
    <section id="scene3d" class="scene3d">
        <canvas></canvas>
        <div class="scene3d-load">Загрузка сцены<div class="scene3d-bar"><i></i></div></div>
        <div class="scene3d-err"></div>
        <div class="scene3d-text">
        </div>
    </section>

    <main class="container">

        <!-- HERO -->
        <section class="hero">

            <div class="hero-text">

                <p class="subtitle">DISCOVER · EXPLORE · EXPERIENCE</p>

                <h1>
                    Открой для себя
                    <span>Астану</span>
                </h1>

                <p class="hero-description">
                    Исследуй архитектуру, историю и удивительные
                    достопримечательности столицы Казахстана.
                    Открой город с новой стороны.
                </p>

                <% if (isAdmin) { %>
                    <a href="/add" class="button add-place-btn">
                        + Добавить достопримечательность
                    </a>
                <% } %>

                <div class="hero-dots">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>

                <p class="hero-caption">
                    ASTANA GUIDE — DIGITAL CITY EXPERIENCE
                </p>

            </div>

        </section>


        <!-- WELCOME -->
        <section class="welcome-section">

            <div class="welcome-decoration">✧</div>

            <p class="subtitle">WELCOME TO ASTANA</p>

            <h2>Город будущего</h2>

            <span>
                Современная архитектура, культурное наследие
                и уникальная атмосфера столицы.
            </span>

        </section>


        <!-- PLACES -->
        <section class="places-section">

            <div class="section-heading">

                <div>
                    <p class="subtitle">EXPLORE THE CAPITAL</p>
                    <h2>Интересные места</h2>
                </div>

                <span class="places-count">
                    <%= places.length %> МЕСТ
                </span>

            </div>


            <% if (places.length === 0) { %>

                <div class="empty-state">

                    <span class="empty-flower">✧</span>

                    <h3>Пока нет достопримечательностей</h3>

                    <p>
                        Скоро здесь появятся интересные места Астаны.
                    </p>

                </div>

            <% } else { %>

                <div class="cards">

                    <% places.forEach(function(place, index) { %>

                        <article class="card">

                            <div class="card-image-wrapper">

                                <% if (place.image) { %>

                                    <img
                                        src="<%= place.image %>"
                                        alt="<%= place.title %>"
                                        class="card-image"
                                        onerror="this.style.display='none'"
                                    >

                                <% } else { %>

                                    <div class="image-placeholder">
                                        <span>ASTANA</span>
                                        <span class="placeholder-flower">✧</span>
                                    </div>

                                <% } %>

                                <span class="card-number">
                                    <%= String(index + 1).padStart(2, "0") %>
                                </span>

                            </div>


                            <div class="card-content">

                                <p class="category">
                                    <%= place.category || "Достопримечательность" %>
                                </p>

                                <h3><%= place.title %></h3>

                                <p class="card-description">
                                    <%= place.description %>
                                </p>

                                <p class="time">
                                    Время посещения:
                                    <%= place.time || "Не указано" %>
                                </p>

                                <a
                                    href="/place/<%= place.id %>"
                                    class="card-link"
                                >
                                    Подробнее <span>→</span>
                                </a>


                                <% if (isAdmin) { %>

                                    <div class="admin-card-actions">

                                        <button
                                            type="button"
                                            class="edit-place"
                                            data-id="<%= place.id %>"
                                            data-title="<%= place.title %>"
                                            data-description="<%= place.description %>"
                                            data-category="<%= place.category %>"
                                            data-time="<%= place.time %>"
                                            data-image="<%= place.image || '' %>"
                                        >
                                            Редактировать
                                        </button>

                                        <button
                                            type="button"
                                            class="delete-place"
                                            data-id="<%= place.id %>"
                                        >
                                            Удалить
                                        </button>

                                    </div>

                                <% } %>

                            </div>

                        </article>

                    <% }); %>

                </div>

            <% } %>

        </section>


        <!-- ABOUT -->
        <section class="about-banner">

            <div>

                <p class="subtitle">GET TO KNOW THE CITY</p>

                <h2>
                    Астана — больше,
                    чем просто город
                </h2>

                <p>
                    Открой для себя столицу Казахстана
                    с новой стороны.
                </p>

                <a href="/about" class="banner-link">
                    О нашем проекте →
                </a>

            </div>

            <div class="banner-flower">✧</div>

        </section>

    </main>


    <%- include("partials/footer", { year: 2026 }) %>


    <script>

    // Удаление достопримечательности

    document.querySelectorAll(".delete-place").forEach(button => {

        button.addEventListener("click", async () => {

            const id = button.dataset.id;

            const confirmDelete = confirm(
                "Вы действительно хотите удалить эту достопримечательность?"
            );

            if (!confirmDelete) return;

            try {

                const response = await fetch(`/api/places/${id}`, {
                    method: "DELETE"
                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.message);
                    return;
                }

                alert(result.message);
                location.reload();

            } catch (error) {

                console.error(error);
                alert("Ошибка при удалении.");

            }

        });

    });


    // Редактирование достопримечательности

    document.querySelectorAll(".edit-place").forEach(button => {

        button.addEventListener("click", async () => {

            const id = button.dataset.id;

            const title = prompt(
                "Название:",
                button.dataset.title
            );

            if (title === null) return;

            const description = prompt(
                "Описание:",
                button.dataset.description
            );

            if (description === null) return;

            const category = prompt(
                "Категория:",
                button.dataset.category
            );

            if (category === null) return;

            const time = prompt(
                "Время посещения:",
                button.dataset.time
            );

            if (time === null) return;

            const image = prompt(
                "Ссылка или путь к изображению:",
                button.dataset.image
            );

            if (image === null) return;

            try {

                const response = await fetch(`/api/places/${id}`, {

                    method: "PUT",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({
                        title,
                        description,
                        category,
                        time,
                        image
                    })

                });

                const result = await response.json();

                if (!response.ok) {
                    alert(result.message);
                    return;
                }

                alert(result.message);
                location.reload();

            } catch (error) {

                console.error(error);
                alert("Ошибка при редактировании.");

            }

        });

    });

    </script>

    <!-- Скрипт 3D-сцены (перед закрытием body) -->
    <script type="module" src="/js/scene.js"></script>

</body>
</html>